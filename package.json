{
  "name": "menu-extract",
  "version": "0.1.0",
  "description": "Turn restaurant menus (PDF, image, HTML, text, DOCX) into a validated, vendor-neutral JSON menu model using an LLM behind a swappable interface.",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": { "menu-extract": "dist/cli.js" },
  "files": ["dist", "fixtures", "README.md", "LICENSE"],
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "cli": "tsx src/cli.ts"
  },
  "dependencies": {
    "jszip": "^3.10.1",
    "zod": "^3.24.4"
  },
  "peerDependencies": {
    "mupdf": "^1.27.0",
    "sharp": "^0.34.0"
  },
  "peerDependenciesMeta": {
    "mupdf": { "optional": true },
    "sharp": { "optional": true }
  },
  "devDependencies": {
    "@types/node": "^22",
    "mupdf": "^1.27.0",
    "sharp": "^0.34.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8",
    "vitest": "^3.1.4"
  }
}
